# PulseChain Configuration
RPC_URL=https://rpc.pulsechain.com

# Your wallet private key (NEVER share this!)
# Get this from your wallet's export private key function
PRIVATE_KEY=0xyour_private_key_here_keep_this_secret

# Wallet address to monitor for TIME dividends
# This should be the address holding TIME tokens
WALLET_ADDRESS=0xYourWalletAddressHere

# Threshold in PLS (minimum claimable amount before claiming)
# Example: 100 means it will claim when >= 100 PLS is available
THRESHOLD_PLS=1500

# Percentage of claimed PLS to use for compounding (buying more TIME tokens)
# Example: 15 means use 15% to buy TIME and hold it for increased dividends
COMPOUND_PERCENTAGE=15

# Percentage of claimed PLS to use for buying exampleToken (0-100)
# Example: 55 means use 55% to buy exampleToken tokens
BUY_PERCENTAGE=55

# exampleToken recipient wallet address
# Where to send the purchased exampleToken tokens
EXAMPLE_TOKEN_RECIPIENT_ADDRESS=0xAddressHere

# Claim check interval in minutes (how often to check for claimable dividends)
# Example: 15 means check every 15 minutes
CLAIM_CHECK_INTERVAL_MINUTES=15
